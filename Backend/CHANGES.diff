--- orig/src/middleware/attachAdmin.js	1970-01-01 00:00:00.000000000 +0000
+++ Backend/src/middleware/attachAdmin.js	2026-11-02 07:31:54.251270704 +0000
@@ -0,0 +1,21 @@
+const User = require('../models/User');
+const { getIsConnected } = require('../config/db');
+
+/**
+ * Run AFTER requireAuth / optionalAuth. Sets req.isAdmin = true only when the
+ * signed-in user's role in the database is 'admin'. Never rejects the request.
+ * The role is read from the database on every request (not from the token), so
+ * removing someone's admin role takes effect immediately.
+ */
+module.exports = async function attachAdmin(req, res, next) {
+  req.isAdmin = false;
+  try {
+    if (req.userId && getIsConnected()) {
+      const u = await User.findById(req.userId).select('role').lean();
+      req.isAdmin = !!u && u.role === 'admin';
+    }
+  } catch {
+    // invalid id format or DB error: treat as not admin
+  }
+  next();
+};
