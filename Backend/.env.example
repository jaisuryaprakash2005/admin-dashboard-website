MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/Probridge?retryWrites=true&w=majority
JWT_SECRET=your_jwt_secret_dev_key
PORT=5000

# Cloudinary credentials
CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
CLOUDINARY_API_KEY=your_cloudinary_api_key
CLOUDINARY_API_SECRET=your_cloudinary_api_secret
CLOUDINARY_UPLOAD_PRESET=your_upload_preset

# Admin seed credentials
SUPERADMIN_EMAIL=superadmin@example.com
SUPERADMIN_PASSWORD=your_superadmin_password
SUPERADMIN_NAME=Super Admin
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=your_admin_password
ADMIN_NAME=Admin

# Firebase Phone Verification
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_PHONE_TOKEN=your_firebase_phone_token
FIREBASE_PROJECT_ID=your_firebase_project_id
