# URL of your ProBridge backend (Backend/src/server.js, default port 5000)
# In production, replace with your live backend URL (e.g. https://your-backend.onrender.com)
VITE_API_BASE_URL=http://localhost:5000

# Mapbox public access token for the Location Picker map
VITE_MAPBOX_ACCESS_TOKEN=your_mapbox_access_token_here

# Cloudinary (for direct image uploads)
VITE_CLOUDINARY_CLOUD_NAME=your_cloudinary_cloud_name
VITE_CLOUDINARY_UPLOAD_PRESET=your_upload_preset
